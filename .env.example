# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Processing Provider Configuration
# Mode: 'mock' (local testing) or 'external' (remote service)
PROCESSING_PROVIDER=mock
PROCESSING_API_URL=https://api.external-processor.com
PROCESSING_API_KEY=your-processing-api-key-here

# Rate Limiting & Lifecycle Rules (Optional overrides)
RATE_LIMIT_GUEST_ANALYZE_PER_HOUR=5
RATE_LIMIT_GUEST_DOWNLOAD_PER_HOUR=2
RATE_LIMIT_USER_ANALYZE_PER_HOUR=30
RATE_LIMIT_USER_DOWNLOAD_PER_HOUR=10
FILE_EXPIRATION_HOURS=2
